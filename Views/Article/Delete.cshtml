@model MyWebApp.Models.Article

@{
    ViewData["Title"] = "Delete Article";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card shadow-sm">
    <div class="card-header bg-white">
        <h5 class="mb-0 text-danger">Delete Article</h5>
    </div>
    <div class="card-body">
        <h6>Are you sure you want to delete this article?</h6>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">Title</dt>
            <dd class="col-sm-10">@Model.Title</dd>
            
            <dt class="col-sm-2">Author</dt>
            <dd class="col-sm-10">@Model.Author?.UserName</dd>
            
            <dt class="col-sm-2">Created Date</dt>
            <dd class="col-sm-10">@Model.CreatedDate.ToString("f")</dd>
            
            <dt class="col-sm-2">Status</dt>
            <dd class="col-sm-10">
                @if (Model.IsPublished)
                {
                    <span class="badge bg-success">Published</span>
                }
                else
                {
                    <span class="badge bg-warning">Draft</span>
                }
            </dd>
        </dl>
        
        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                <input type="submit" value="Delete" class="btn btn-danger" />
            </div>
        </form>
    </div>
</div>