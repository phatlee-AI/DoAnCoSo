@model IEnumerable<MyWebApp.Models.DesignRequest>

@{
    ViewData["Title"] = "Thiết kế của tôi";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <h2 class="mb-0">
            <i class="fas fa-pencil-ruler me-2 text-success"></i>
            @ViewData["Title"]
        </h2>
        <a asp-action="Create" class="btn btn-success">
            <i class="fas fa-plus me-2"></i>Tạo thiết kế mới
        </a>
    </div>
    
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <strong>Thành công!</strong> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var design in Model)
            {
                <div class="col-12">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="row g-0 h-100">
                            <!-- Cột hiển thị mô hình 3D -->
                            <div class="col-md-5">
                                <div class="h-100 p-3 d-flex align-items-center justify-content-center bg-light">
                                    <model-viewer 
                                        src="@design.Product?.Model3DUrl"
                                        ar ar-modes="webxr scene-viewer quick-look" 
                                        camera-controls 
                                        auto-rotate
                                        style="width:100%; height:300px;">
                                        <div slot="progress-bar" class="progress-bar"></div>
                                    </model-viewer>
                                </div>
                            </div>
                            
                            <!-- Cột thông tin chi tiết -->
                            <div class="col-md-7">
                                <div class="card-body h-100 d-flex flex-column">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h4 class="card-title mb-1">@design.Product?.Name</h4>
                                            <p class="text-muted small mb-2">Ngày tạo: @design.CreatedDate.ToString("dd/MM/yyyy HH:mm")</p>
                                            <span class="badge @GetStatusBadgeClass(design.Status)">
                                                @design.Status
                                            </span>
                                        </div>
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" 
                                                    data-bs-toggle="dropdown" aria-expanded="false">
                                                <i class="fas fa-ellipsis-v"></i>
                                            </button>
                                            <ul class="dropdown-menu">
                                                <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@design.Id">
                                                    <i class="fas fa-edit me-2"></i>Chỉnh sửa
                                                </a></li>
                                                <li><a class="dropdown-item" asp-action="Details" asp-route-id="@design.Id">
                                                    <i class="fas fa-info-circle me-2"></i>Chi tiết
                                                </a></li>
                                                <li><button class="dropdown-item copy-design-btn" data-design-id="@design.Id">
                                                    <i class="fas fa-copy me-2"></i>Sao chép thông số
                                                </button></li>
                                                <li><hr class="dropdown-divider"></li>
                                                <li><a class="dropdown-item text-danger" href="#" data-bs-toggle="modal" 
                                                      data-bs-target="#deleteModal-@design.Id">
                                                    <i class="fas fa-trash-alt me-2"></i>Xóa
                                                </a></li>
                                            </ul>
                                        </div>
                                    </div>
                                    
                                    <hr class="my-3">
                                    
                                    <!-- Thông số thiết kế -->
                                    <div class="row g-2 mb-3">
                                        <div class="col-6">
                                            <div class="p-2 bg-light rounded">
                                                <small class="text-muted d-block">Màu mặt trước</small>
                                                <div class="d-flex align-items-center mt-1">
                                                    <div class="color-swatch me-2" style="background-color: @design.FrontColor;"></div>
                                                    <span data-color="front">@design.FrontColor</span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="p-2 bg-light rounded">
                                                <small class="text-muted d-block">Màu mặt sau</small>
                                                <div class="d-flex align-items-center mt-1">
                                                    <div class="color-swatch me-2" style="background-color: @design.BackColor;"></div>
                                                    <span data-color="back">@design.BackColor</span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="p-2 bg-light rounded">
                                                <small class="text-muted d-block">Màu viền cổ</small>
                                                <div class="d-flex align-items-center mt-1">
                                                    <div class="color-swatch me-2" style="background-color: @design.CollarColor;"></div>
                                                    <span data-color="collar">@design.CollarColor</span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="p-2 bg-light rounded h-100">
                                                <small class="text-muted d-block">Hình ảnh</small>
                                                @if (!string.IsNullOrEmpty(design.ImagePath))
                                                {
                                                    <div class="mt-2 text-center">
                                                        <img src="@design.ImagePath" class="img-thumbnail" style="max-height: 80px; width: auto;">
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Không có</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="p-2 bg-light rounded">
                                                <small class="text-muted d-block">Nội dung chữ</small>
                                                <span data-content="text">@(!string.IsNullOrEmpty(design.TextContent) ? design.TextContent : "Không có")</span>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="p-2 bg-light rounded">
                                                <small class="text-muted d-block">Font chữ</small>
                                                <span data-content="font">@(!string.IsNullOrEmpty(design.TextFont) ? design.TextFont : "Không có")</span>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="p-2 bg-light rounded">
                                                <small class="text-muted d-block">Màu chữ</small>
                                                <div class="d-flex align-items-center mt-1">
                                                    @if (!string.IsNullOrEmpty(design.TextColor))
                                                    {
                                                        <div class="color-swatch me-2" style="background-color: @design.TextColor;"></div>
                                                        <span data-color="text">@design.TextColor</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">Không có</span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <!-- Thông tin khách hàng -->
                                    <div class="mt-auto pt-2">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <small class="text-muted d-block">Khách hàng</small>
                                                <strong>@design.CustomerName</strong>
                                            </div>
                                            <div class="text-end">
                                                <small class="text-muted d-block">Liên hệ</small>
                                                <div>@design.CustomerPhone</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Modal xác nhận xóa -->
                    <div class="modal fade" id="deleteModal-@design.Id" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">Xác nhận xóa</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <p>Bạn có chắc chắn muốn xóa thiết kế "@design.Product?.Name" này?</p>
                                    <p class="text-muted small">Thao tác này không thể hoàn tác.</p>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                                    <form asp-action="Delete" method="post">
                                        <input type="hidden" name="id" value="@design.Id" />
                                        <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-pencil-ruler fa-3x text-muted mb-3"></i>
            <h5 class="text-muted">Bạn chưa có thiết kế nào</h5>
            <a asp-action="Create" class="btn btn-success mt-3">
                <i class="fas fa-plus me-2"></i>Tạo thiết kế đầu tiên
            </a>
        </div>
    }
</div>

@section Styles {
    <style>
        .color-swatch {
            width: 20px;
            height: 20px;
            border-radius: 4px;
            border: 1px solid #dee2e6;
        }
        
        model-viewer {
            --progress-bar-color: #4CAF50;
            --progress-bar-height: 5px;
        }
        
        .progress-bar {
            display: block;
            width: 100%;
            height: var(--progress-bar-height);
            background-color: var(--progress-bar-color);
            position: absolute;
            bottom: 0;
            left: 0;
        }
        
        .card {
            transition: transform 0.2s ease-in-out;
        }
        
        .card:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }
        
        .img-thumbnail {
            padding: 0.25rem;
            background-color: #fff;
            border: 1px solid #dee2e6;
            border-radius: 0.25rem;
            max-width: 100%;
            height: auto;
        }

        .toast-container {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 1100;
        }

        .toast {
            transition: opacity 0.3s ease;
        }
    </style>
}

@section Scripts {
    <script type="module" src="https://unpkg.com/@@google/model-viewer/dist/model-viewer.min.js"></script>
    
    <script>
        $(document).ready(function() {
            // Add toast container to body
            $('body').append('<div class="toast-container"></div>');

            // Copy design specs to clipboard
            $('.copy-design-btn').click(async function() {
                const card = $(this).closest('.card');
                const designId = $(this).data('design-id');
                
                // Lấy tất cả thông tin cần thiết
                const productName = card.find('.card-title').text().trim();
                const createdDate = card.find('.text-muted.small').text().replace('Ngày tạo: ', '').trim();
                const status = card.find('.badge').text().trim();
                
                const frontColor = card.find('[data-color="front"]').text().trim();
                const backColor = card.find('[data-color="back"]').text().trim();
                const collarColor = card.find('[data-color="collar"]').text().trim();
                const textContent = card.find('[data-content="text"]').text().trim();
                const textColor = card.find('[data-color="text"]').text().trim();
                const textFont = card.find('[data-content="font"]').text().trim();
                
                const imageElement = card.find('.img-thumbnail');
                const imagePath = imageElement.length ? imageElement.attr('src') : "Không có";
                
                const model3DUrl = card.find('model-viewer').attr('src') || "Không có";
                const customerName = card.find('.mt-auto strong').text().trim();
                const customerPhone = card.find('.mt-auto div:last-child').text().trim();

                // Tạo nội dung đầy đủ để copy
                const content = `
THÔNG TIN THIẾT KẾ
──────────────────
Tên sản phẩm: ${productName}
Mã thiết kế: DSN-${designId.toString().padStart(5, '0')}
Ngày tạo: ${createdDate}
Trạng thái: ${status}

THÔNG SỐ THIẾT KẾ
──────────────────
• Màu mặt trước: ${frontColor}
• Màu mặt sau: ${backColor}
• Màu viền cổ: ${collarColor}
• Nội dung chữ: ${textContent !== "Không có" ? textContent : "Không có"}
• Màu chữ: ${textColor !== "Không có" ? textColor : "Không có"}
• Font chữ: ${textFont !== "Không có" ? textFont : "Không có"}
• Hình ảnh: ${imagePath}
• Mô hình 3D: ${model3DUrl}

THÔNG TIN KHÁCH HÀNG
──────────────────
• Họ tên: ${customerName}
• Số điện thoại: ${customerPhone}
──────────────────
                `;

                try {
                    // Sử dụng Clipboard API hiện đại
                    await navigator.clipboard.writeText(content.trim());
                    
                    // Hiển thị thông báo thành công
                    showToast('Đã sao chép thông số thiết kế vào clipboard!', 'success');
                } catch (err) {
                    console.error('Failed to copy: ', err);
                    
                    // Fallback cho trình duyệt không hỗ trợ Clipboard API
                    try {
                        const textarea = document.createElement('textarea');
                        textarea.value = content.trim();
                        document.body.appendChild(textarea);
                        textarea.select();
                        document.execCommand('copy');
                        document.body.removeChild(textarea);
                        
                        showToast('Đã sao chép thông số thiết kế!', 'success');
                    } catch (err2) {
                        console.error('Fallback copy failed: ', err2);
                        showToast('Lỗi khi sao chép!', 'danger');
                    }
                }
            });

            // Hàm hiển thị toast thông báo
            function showToast(message, type = 'success') {
                const toast = $(`
                    <div class="toast show align-items-center text-white bg-${type} border-0" role="alert" aria-live="assertive" aria-atomic="true">
                        <div class="d-flex">
                            <div class="toast-body">
                                <i class="fas ${type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle'} me-2"></i>
                                ${message}
                            </div>
                            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                        </div>
                    </div>
                `);
                
                $('.toast-container').empty().append(toast);
                
                // Tự động ẩn toast sau 3 giây
                setTimeout(() => {
                    toast.remove();
                }, 3000);
            }
        });
    </script>
}

@functions {
    string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Hoàn thành" => "bg-success",
            "Đang thiết kế" => "bg-warning",
            "Đã hủy" => "bg-secondary",
            "Chờ duyệt" => "bg-info",
            _ => "bg-primary"
        };
    }
}