@model IEnumerable<MyWebApp.Models.Product>

@{
    ViewData["Title"] = "Sản phẩm";
    
    // Xử lý null cho Model
    var products = Model?.ToList() ?? new List<MyWebApp.Models.Product>();
    var featuredProducts = products.Take(3).ToList(); // 3 sản phẩm nổi bật
    var regularProducts = products.Skip(3).ToList(); // Các sản phẩm thường
}

<!-- Banner sản phẩm -->
<div class="product-banner bg-success text-white py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="display-4 fw-bold mb-3">Bộ sưu tập sản phẩm</h1>
                <p class="lead mb-4">Khám phá những thiết kế độc đáo và chất lượng cao từ PHATLEE</p>
                <div class="d-flex gap-3">
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Create" class="btn btn-light btn-lg px-4">
                            <i class="fas fa-plus-circle me-2"></i>Thêm sản phẩm
                        </a>
                    }
                    <a href="#featured-products" class="btn btn-outline-light btn-lg px-4">
                        <i class="fas fa-arrow-down me-2"></i>Khám phá
                    </a>
                </div>
            </div>
            <div class="col-lg-6 d-none d-lg-block">
                <img src="/images/product-showcase.png" alt="Product Showcase" class="img-fluid">
            </div>
        </div>
    </div>
</div>

<!-- Nội dung chính -->
<div class="container py-5" id="featured-products">
    <!-- Thanh công cụ -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-5">
        <div class="mb-3 mb-md-0">
            <h2 class="mb-1"><i class="fas fa-box-open me-2 text-success"></i>Danh sách sản phẩm</h2>
            <p class="text-muted mb-0">Hiển thị @products.Count sản phẩm</p>
        </div>
        
        <div class="d-flex flex-column flex-sm-row gap-3">
            <!-- Search Form -->
            <form asp-action="Index" method="get" class="d-flex">
                <div class="input-group">
                    <input type="text" name="searchString" class="form-control" placeholder="Tìm kiếm sản phẩm..." value="@ViewBag.SearchString">
                    <button class="btn btn-success" type="submit">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
            </form>
            
            <!-- Bộ lọc -->
            <div class="dropdown">
                <button class="btn btn-outline-success dropdown-toggle" type="button" id="filterDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="fas fa-filter me-2"></i>Bộ lọc
                </button>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="filterDropdown">
                    <li><h6 class="dropdown-header">Danh mục</h6></li>
                    @foreach (var category in ViewBag.Categories ?? new List<Category>())
                    {
                        <li><a class="dropdown-item" asp-action="Index" asp-route-categoryId="@category.Id">@category.Name</a></li>
                    }
                    <li><hr class="dropdown-divider"></li>
                    <li><h6 class="dropdown-header">Sắp xếp</h6></li>
                    <li><a class="dropdown-item" asp-action="Index" asp-route-sortOrder="price_asc">Giá thấp đến cao</a></li>
                    <li><a class="dropdown-item" asp-action="Index" asp-route-sortOrder="price_desc">Giá cao đến thấp</a></li>
                    <li><a class="dropdown-item" asp-action="Index" asp-route-sortOrder="newest">Mới nhất</a></li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Sản phẩm nổi bật -->
    @if (featuredProducts.Any())
    {
        <div class="mb-5">
            <h3 class="mb-4"><i class="fas fa-star me-2 text-warning"></i>Sản phẩm nổi bật</h3>
            <div class="row row-cols-1 row-cols-md-3 g-4">
                @foreach (var product in featuredProducts)
                {
                    <div class="col">
                        <div class="card h-100 border-0 shadow-sm featured-product">
                            @if (!string.IsNullOrEmpty(product.Model3DUrl))
                            {
                                <span class="position-absolute top-0 end-0 m-2 badge bg-info">
                                    <i class="fas fa-cube me-1"></i>3D
                                </span>
                            }
                            
                            <div class="featured-image-container">
                                <img src="@(product.ImageUrl ?? "/images/default-product.png")" class="card-img-top" alt="@product.Name">
                                <div class="featured-actions">
                                    <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-success btn-sm rounded-circle">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-inline">
                                        <input type="hidden" name="productId" value="@product.Id" />
                                        <input type="hidden" name="quantity" value="1" />
                                        <button type="submit" class="btn btn-success btn-sm rounded-circle">
                                            <i class="fas fa-cart-plus"></i>
                                        </button>
                                    </form>
                                    @if (!string.IsNullOrEmpty(product.Model3DUrl))
                                    {
                                        <a asp-controller="Design" asp-action="Create" asp-route-productId="@product.Id" class="btn btn-primary btn-sm rounded-circle">
                                            <i class="fas fa-pencil-ruler"></i>
                                        </a>
                                    }
                                </div>
                            </div>
                            
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start">
                                    <h5 class="card-title mb-1">@product.Name</h5>
                                    <span class="badge bg-success">Nổi bật</span>
                                </div>
                                <p class="text-muted small mb-2">@(product.Category?.Name ?? "Chưa phân loại")</p>
                                
                                <div class="d-flex align-items-center mb-2">
                                    <div class="rating-stars text-warning small">
                                        <i class="fas fa-star"></i>
                                        <i class="fas fa-star"></i>
                                        <i class="fas fa-star"></i>
                                        <i class="fas fa-star"></i>
                                        <i class="far fa-star"></i>
                                    </div>
                                    <span class="ms-2 small">(12 đánh giá)</span>
                                </div>
                                
                                <p class="card-text text-truncate-3 mb-3">@product.Description</p>
                                <h5 class="text-success mb-0">@product.Price.ToString("N0")đ</h5>
                            </div>
                            
                            <div class="card-footer bg-white border-0 pt-0">
                                <div class="d-flex justify-content-between">
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <div class="btn-group">
                                            <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-secondary">
                                                <i class="fas fa-edit me-1"></i>Sửa
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-outline-danger">
                                                <i class="fas fa-trash-alt me-1"></i>Xóa
                                            </a>
                                        </div>
                                    }
                                    else
                                    {
                                        <span></span>
                                    }
                                    <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-sm btn-success">
                                        <i class="fas fa-shopping-cart me-1"></i>Mua ngay
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Tất cả sản phẩm -->
    <div class="mb-5">
        <h3 class="mb-4"><i class="fas fa-th-large me-2 text-success"></i>Tất cả sản phẩm</h3>
        @if (regularProducts.Any())
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
                @foreach (var product in regularProducts)
                {
                    <div class="col">
                        <div class="card h-100 border-0 shadow-sm product-card">
                            @if (!string.IsNullOrEmpty(product.Model3DUrl))
                            {
                                <span class="position-absolute top-0 end-0 m-2 badge bg-info">
                                    <i class="fas fa-cube me-1"></i>3D
                                </span>
                            }
                            
                            <div class="product-image-container">
                                <img src="@(product.ImageUrl ?? "/images/default-product.png")" class="card-img-top" alt="@product.Name">
                                <div class="product-actions">
                                    <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-success btn-sm rounded-circle">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-inline">
                                        <input type="hidden" name="productId" value="@product.Id" />
                                        <input type="hidden" name="quantity" value="1" />
                                        <button type="submit" class="btn btn-success btn-sm rounded-circle">
                                            <i class="fas fa-cart-plus"></i>
                                        </button>
                                    </form>
                                    @if (!string.IsNullOrEmpty(product.Model3DUrl))
                                    {
                                        <a asp-controller="Design" asp-action="Create" asp-route-productId="@product.Id" class="btn btn-primary btn-sm rounded-circle">
                                            <i class="fas fa-pencil-ruler"></i>
                                        </a>
                                    }
                                </div>
                            </div>
                            
                            <div class="card-body">
                                <h5 class="card-title">@product.Name</h5>
                                <p class="text-muted small mb-2">@(product.Category?.Name ?? "Chưa phân loại")</p>
                                
                                <div class="d-flex align-items-center mb-2">
                                    <div class="rating-stars text-warning small">
                                        <i class="fas fa-star"></i>
                                        <i class="fas fa-star"></i>
                                        <i class="fas fa-star"></i>
                                        <i class="fas fa-star"></i>
                                        <i class="far fa-star"></i>
                                    </div>
                                    <span class="ms-2 small">(12 đánh giá)</span>
                                </div>
                                
                                <p class="card-text text-truncate-3 mb-3">@product.Description</p>
                                <h5 class="text-success mb-0">@product.Price.ToString("N0")đ</h5>
                            </div>
                            
                            <div class="card-footer bg-white border-0 pt-0">
                                <div class="d-flex justify-content-between">
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <div class="btn-group">
                                            <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-secondary">
                                                <i class="fas fa-edit me-1"></i>Sửa
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-outline-danger">
                                                <i class="fas fa-trash-alt me-1"></i>Xóa
                                            </a>
                                        </div>
                                    }
                                    else
                                    {
                                        <span></span>
                                    }
                                    <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-sm btn-success">
                                        <i class="fas fa-shopping-cart me-1"></i>Mua ngay
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            
            <!-- Phân trang -->
            @if (ViewBag.TotalPages > 1)
            {
                <nav aria-label="Page navigation" class="mt-5">
                    <ul class="pagination justify-content-center">
                        @if (ViewBag.CurrentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="Index" 
                                   asp-route-page="@(ViewBag.CurrentPage - 1)" 
                                   asp-route-searchString="@ViewBag.SearchString"
                                   asp-route-categoryId="@ViewBag.CategoryId"
                                   asp-route-sortOrder="@ViewBag.SortOrder">
                                    &laquo;
                                </a>
                            </li>
                        }
                        
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" 
                                   asp-route-page="@i"
                                   asp-route-searchString="@ViewBag.SearchString"
                                   asp-route-categoryId="@ViewBag.CategoryId"
                                   asp-route-sortOrder="@ViewBag.SortOrder">
                                    @i
                                </a>
                            </li>
                        }
                        
                        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="Index" 
                                   asp-route-page="@(ViewBag.CurrentPage + 1)"
                                   asp-route-searchString="@ViewBag.SearchString"
                                   asp-route-categoryId="@ViewBag.CategoryId"
                                   asp-route-sortOrder="@ViewBag.SortOrder">
                                    &raquo;
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-box-open fa-3x text-muted mb-3"></i>
                <h5 class="text-muted">Không tìm thấy sản phẩm nào</h5>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Create" class="btn btn-success mt-3">
                        <i class="fas fa-plus me-2"></i>Thêm sản phẩm mới
                    </a>
                }
            </div>
        }
    </div>
</div>

@section Styles {
    <style>
        /* Banner sản phẩm */
        .product-banner {
            background: linear-gradient(135deg, #4CAF50 0%, #2E7D32 100%);
            margin-bottom: 2rem;
        }
        
        /* Card sản phẩm */
        .product-card, .featured-product {
            transition: all 0.3s ease;
            border-radius: 0.5rem;
            overflow: hidden;
            border: 1px solid rgba(0,0,0,0.05);
        }
        
        .product-card:hover, .featured-product:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(76, 175, 80, 0.1);
        }
        
        .featured-product {
            border: 2px solid #FFC107;
        }
        
        /* Hình ảnh sản phẩm */
        .product-image-container, .featured-image-container {
            position: relative;
            overflow: hidden;
            height: 200px;
        }
        
        .featured-image-container {
            height: 250px;
        }
        
        .product-image-container img, .featured-image-container img {
            transition: transform 0.3s ease;
            object-fit: cover;
            width: 100%;
            height: 100%;
        }
        
        .product-image-container:hover img, .featured-image-container:hover img {
            transform: scale(1.05);
        }
        
        .product-actions, .featured-actions {
            position: absolute;
            bottom: -50px;
            left: 0;
            right: 0;
            display: flex;
            justify-content: center;
            gap: 10px;
            padding: 10px;
            transition: bottom 0.3s ease;
            opacity: 0;
        }
        
        .product-card:hover .product-actions, .featured-product:hover .featured-actions {
            bottom: 10px;
            opacity: 1;
        }
        
        .product-actions .btn, .featured-actions .btn {
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        /* Text truncate */
        .text-truncate-3 {
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        
        /* Rating stars */
        .rating-stars {
            letter-spacing: 2px;
        }
        
        /* Phân trang */
        .pagination .page-item.active .page-link {
            background-color: #4CAF50;
            border-color: #4CAF50;
        }
        
        .pagination .page-link {
            color: #4CAF50;
        }
    </style>
}