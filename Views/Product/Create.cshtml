@model MyWebApp.Models.Product

@{
    ViewData["Title"] = "Create New Product";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow">
                <div class="card-header bg-success text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0"><i class="fas fa-plus-circle me-2"></i>Create New Product</h4>
                        <a asp-action="Index" class="btn btn-sm btn-light">
                            <i class="fas fa-arrow-left me-1"></i>Back to List
                        </a>
                    </div>
                </div>
                
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" enctype="multipart/form-data" class="needs-validation" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        
                        <div class="row g-3">
                            <!-- Basic Information -->
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Name" class="form-label fw-bold">Product Name</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fas fa-tag"></i></span>
                                        <input asp-for="Name" class="form-control" placeholder="Enter product name" required />
                                    </div>
                                    <span asp-validation-for="Name" class="text-danger small"></span>
                                </div>
                                
                                <div class="form-group mb-3">
                                    <label asp-for="Price" class="form-label fw-bold">Price</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fas fa-dollar-sign"></i></span>
                                        <input asp-for="Price" class="form-control" placeholder="0.00" required />
                                    </div>
                                    <span asp-validation-for="Price" class="text-danger small"></span>
                                </div>
                                
                                <div class="form-group mb-3">
                                    <label asp-for="CategoryId" class="form-label fw-bold">Category</label>
                                    <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId" required>
                                        <option value="">-- Select Category --</option>
                                    </select>
                                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                                </div>
                            </div>
                            
                            <!-- Image Upload -->
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="ImageUrl" class="form-label fw-bold">Main Image</label>
                                    <div class="file-upload-container border rounded p-3 text-center">
                                        <div class="ChuaAnh mb-3">
                                            <img src="https://via.placeholder.com/300x200?text=Product+Image" id="mainImagePreview" class="img-thumbnail" style="max-height: 150px; width: auto;" />
                                        </div>
                                        <label for="AnhVuaTai" class="btn btn-outline-success btn-sm">
                                            <i class="fas fa-cloud-upload-alt me-1"></i>Choose Image
                                        </label>
                                        <input name="HinhAnhCapNhat" id="AnhVuaTai" type="file" class="d-none" accept="image/*" />
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Description -->
                            <div class="col-12">
                                <div class="form-group mb-3">
                                    <label asp-for="Description" class="form-label fw-bold">Description</label>
                                    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Enter product description"></textarea>
                                    <span asp-validation-for="Description" class="text-danger small"></span>
                                </div>
                            </div>
                            
                            <!-- Additional Images -->
                            <div class="col-12">
                                <div class="form-group mb-3">
                                    <label class="form-label fw-bold">Additional Images</label>
                                    <div class="file-upload-container border rounded p-3">
                                        <div class="ChuaAnhDS mb-3 d-flex flex-wrap gap-2">
                                            <div class="placeholder-image border p-2 text-center" style="width: 120px; height: 120px;">
                                                <i class="fas fa-images text-muted" style="font-size: 2rem;"></i>
                                                <p class="small text-muted mb-0">No images selected</p>
                                            </div>
                                        </div>
                                        <label for="AnhVuaTaiDS" class="btn btn-outline-secondary btn-sm">
                                            <i class="fas fa-images me-1"></i>Choose Multiple Images
                                        </label>
                                        <input name="DanhSachHinhAnh" id="AnhVuaTaiDS" type="file" class="d-none" multiple accept="image/*" />
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Submit Button -->
                            <div class="col-12 mt-4">
                                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                    <button type="submit" class="btn btn-success px-4 py-2">
                                        <i class="fas fa-save me-2"></i>Create Product
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .file-upload-container {
            background-color: #f8f9fa;
            transition: all 0.3s;
        }
        
        .file-upload-container:hover {
            background-color: #e9ecef;
        }
        
        .form-control, .form-select {
            border-radius: 0.25rem;
            border: 1px solid #ced4da;
            transition: border-color 0.3s, box-shadow 0.3s;
        }
        
        .form-control:focus, .form-select:focus {
            border-color: #4CAF50;
            box-shadow: 0 0 0 0.25rem rgba(76, 175, 80, 0.25);
        }
        
        .card {
            border-radius: 0.5rem;
            overflow: hidden;
        }
        
        .card-header {
            border-radius: 0 !important;
        }
        
        .placeholder-image {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            background-color: #f8f9fa;
            border-radius: 0.25rem;
        }
        
        .img-thumbnail {
            object-fit: contain;
            background-color: #f8f9fa;
        }
    </style>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    
    <script>
        // Main image preview
        $("#AnhVuaTai").change(function(e) {
            let file = e.target.files[0];
            if (file) {
                let path = URL.createObjectURL(file);
                $("#mainImagePreview").attr("src", path);
                
                // Remove placeholder if exists
                $(".ChuaAnh .placeholder-image").remove();
            }
        });
        
        // Multiple images preview
        $("#AnhVuaTaiDS").change(function(e) {
            let files = e.target.files;
            $(".ChuaAnhDS").empty();
            
            if (files.length > 0) {
                for (let i = 0; i < files.length; i++) {
                    let path = URL.createObjectURL(files[i]);
                    let imgHtml = `<img src="${path}" class="img-thumbnail" style="width: 120px; height: 120px; object-fit: cover;" />`;
                    $(".ChuaAnhDS").append(imgHtml);
                }
            } else {
                // Show placeholder if no files selected
                $(".ChuaAnhDS").html(`
                    <div class="placeholder-image border p-2 text-center" style="width: 120px; height: 120px;">
                        <i class="fas fa-images text-muted" style="font-size: 2rem;"></i>
                        <p class="small text-muted mb-0">No images selected</p>
                    </div>
                `);
            }
        });
        
        // Bootstrap validation
        (function() {
            'use strict';
            
            // Fetch all the forms we want to apply custom Bootstrap validation styles to
            var forms = document.querySelectorAll('.needs-validation');
            
            // Loop over them and prevent submission
            Array.prototype.slice.call(forms)
                .forEach(function(form) {
                    form.addEventListener('submit', function(event) {
                        if (!form.checkValidity()) {
                            event.preventDefault();
                            event.stopPropagation();
                        }
                        
                        form.classList.add('was-validated');
                    }, false);
                });
        })();
    </script>
}