@model MyWebApp.Models.Product

@{
    ViewData["Title"] = "Delete Product";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow">
                <div class="card-header bg-danger text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0"><i class="fas fa-trash-alt me-2"></i>Delete Product</h4>
                        <a asp-action="Index" class="btn btn-sm btn-light">
                            <i class="fas fa-arrow-left me-1"></i>Back to List
                        </a>
                    </div>
                </div>
                
                <div class="card-body p-4">
                    <div class="alert alert-warning">
                        <h5 class="alert-heading"><i class="fas fa-exclamation-triangle me-2"></i>Warning!</h5>
                        <p class="mb-0">Are you sure you want to delete this product? This action cannot be undone.</p>
                    </div>
                    
                    <div class="product-details">
                        <div class="row mb-4">
                            <!-- Product Image -->
                            <div class="col-md-4 mb-3 mb-md-0">
                                <div class="product-image-container border rounded p-2 bg-light text-center">
                                    <img src="@Model.ImageUrl" class="img-fluid rounded" alt="@Model.Name" style="max-height: 200px; width: auto;" />
                                </div>
                            </div>
                            
                            <!-- Product Info -->
                            <div class="col-md-8">
                                <h3 class="fw-bold mb-3">@Model.Name</h3>
                                <div class="d-flex align-items-center mb-3">
                                    <span class="badge bg-success me-2">@Model.Category.Name</span>
                                    <h4 class="text-danger mb-0">$@Model.Price.ToString("0.00")</h4>
                                </div>
                                <p class="text-muted">@Model.Description</p>
                            </div>
                        </div>
                        
                        <!-- Detailed Info -->
                        <div class="details-table border-top pt-3">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <span class="fw-bold">Product ID:</span>
                                        <span class="text-muted ms-2">@Model.Id</span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <span class="fw-bold">Created:</span>
                                        <span class="text-muted ms-2">@DateTime.Now.ToString("MMMM dd, yyyy")</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Delete Form -->
                    <form asp-action="Delete" class="mt-4">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-danger px-4">
                                <i class="fas fa-trash-alt me-2"></i>Confirm Delete
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .product-image-container {
            transition: all 0.3s;
            background-color: #f8f9fa;
        }
        
        .product-image-container:hover {
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }
        
        .alert-warning {
            border-left: 4px solid #ffc107;
        }
        
        .details-table {
            border-color: rgba(0, 0, 0, 0.1);
        }
        
        .btn-danger {
            transition: all 0.3s;
        }
        
        .btn-danger:hover {
            background-color: #c82333;
            border-color: #bd2130;
        }
    </style>
}