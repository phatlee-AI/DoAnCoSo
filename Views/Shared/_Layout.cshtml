<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PHATLEE</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
</head>
<body>
    <!-- Header -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <!-- Brand Logo -->
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="text-success">PHAT</span><span class="text-dark">LEE</span>
                </a>
                
                <!-- Mobile Toggle Button -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" 
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <!-- Main Navigation -->
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Product" asp-action="Index">Sản phẩm</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Design" asp-action="MyDesign">Thiết Kế Của Tôi</a>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="AboutUs">Về Chúng Tôi</a>
                        </li>
                        <li class="nav-item"></li>
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Contact">Liên Hệ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Admin" asp-action="User">Quản lý</a>
                        </li>
                    </ul>
                    
                    <!-- Right Side Navigation -->
                    <div class="d-flex align-items-center">
                        <!-- Notification Dropdown -->
                        @await Component.InvokeAsync("Notification")
                        
                        <!-- Shopping Cart -->
                        <div class="dropdown me-3">
                            <a class="nav-link position-relative" href="#" id="cartDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-shopping-cart fs-5"></i>
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" id="cart-count">
                                    0
                                </span>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end p-0" aria-labelledby="cartDropdown" style="min-width: 320px;">
                                <div class="cart-dropdown-header p-3 border-bottom">
                                    <h6 class="m-0">Giỏ hàng của bạn</h6>
                                </div>
                                <div id="cart-items" class="px-3 py-2" style="max-height: 300px; overflow-y: auto;">
                                    <div class="text-center py-3">
                                        <i class="fas fa-shopping-cart fa-2x text-muted mb-2"></i>
                                        <p class="text-muted mb-0">Giỏ hàng trống</p>
                                    </div>
                                </div>
                                <div class="cart-dropdown-footer p-3 border-top">
                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Tạm tính:</span>
                                        <span class="fw-bold" id="cart-subtotal">0đ</span>
                                    </div>
                                    <a href="@Url.Action("Index", "Cart")" class="btn btn-success w-100">
                                        <i class="fas fa-shopping-bag me-2"></i>Xem giỏ hàng
                                    </a>
                                </div>
                            </div>
                        </div>
                        
                        <!-- User Dropdown -->
                        <div class="dropdown">
                            @if (User.Identity.IsAuthenticated)
                            {
                                <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                    <img src="https://ui-avatars.com/api/?name=@User.Identity.Name&background=random" 
                                         class="rounded-circle me-2" width="32" height="32" alt="User">
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userDropdown">
                                    <li>
                                        <div class="dropdown-header py-2 px-3">
                                            <div class="d-flex align-items-center">
                                                <img src="https://ui-avatars.com/api/?name=@User.Identity.Name&background=random" 
                                                     class="rounded-circle me-2" width="48" height="48" alt="User">
                                                <div>
                                                    <h6 class="mb-0">@User.Identity.Name</h6>
                                                    <small class="text-muted">Tài khoản của bạn</small>
                                                </div>
                                            </div>
                                        </div>
                                    </li>
                                    <li><hr class="dropdown-divider mx-2 my-1"></li>
                                    <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index"><i class="fas fa-user-circle me-2"></i>Hồ sơ</a></li>
                                    <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Email"><i class="fas fa-envelope me-2"></i>Email</a></li>
                                    <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/ChangePassword"><i class="fas fa-key me-2"></i>Mật khẩu</a></li>
                                    <li><hr class="dropdown-divider mx-2 my-1"></li>
                                    <li>
                                        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home")">
                                            <button type="submit" class="dropdown-item text-danger"><i class="fas fa-sign-out-alt me-2"></i>Đăng xuất</button>
                                        </form>
                                    </li>
                                </ul>
                            }
                            else
                            {
                                <ul class="navbar-nav">
                                    <li class="nav-item"><a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">Đăng ký</a></li>
                                    <li class="nav-item"><a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">Đăng nhập</a></li>
                                </ul>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Banner/Slider -->
    <section class="banner-section"></section>
        <div id="mainCarousel" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <div class="banner-content bg-success text-white">
                        <div class="container py-5">
                            <h1 class="display-4 fw-bold">Let's Create an Amazing Project Together!</h1>
                            <p class="lead">We provide the best services for your needs</p>
                            <a href="#contact" class="btn btn-light btn-lg mt-3">Let's Talk</a>
                        </div>
                    </div>
                </div>
                <div class="carousel-item">
                    <div class="banner-content bg-dark text-white">
                        <div class="container py-5">
                            <h1 class="display-4 fw-bold">Innovative Solutions</h1>
                            <p class="lead">Discover our latest products and services</p>
                            <a href="#products" class="btn btn-success btn-lg mt-3">Explore</a>
                        </div>
                    </div>
                </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#mainCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#mainCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>
    </section>

    <!-- Main Content -->
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    
    <!-- Products Section -->
    @await Component.InvokeAsync("FeaturedProducts")
    <!-- Articles Section -->
    <section id="articles" class="py-5">
        <div class="container">
            <h2 class="text-center mb-5">Latest Articles</h2>
            <div class="row" id="articleList">
                <!-- Articles will be loaded here via JavaScript -->
            </div>
        </div>
    </section>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mt-3">
            @TempData["Success"]
        </div>
    }

    <!-- Contact Section -->
    <section id="contact" class="py-5 bg-light"></section>
    <div class="container">
