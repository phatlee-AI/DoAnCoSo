                                    <i class="fas fa-map-marker-alt fa-2x"></i>
                                </div>
                                <div>
                                    <h5 class="fw-bold mb-1">Địa chỉ</h5>
                                    <p class="mb-0">123 Đường ABC, Phường XYZ<br>Quận 1, TP. Hồ Chí Minh</p>
                                </div>
                            </div>
                            
                            <div class="d-flex mb-3">
                                <div class="me-3 text-success">
                                    <i class="fas fa-phone-alt fa-2x"></i>
                                </div>
                                <div>
                                    <h5 class="fw-bold mb-1">Điện thoại</h5>
                                    <p class="mb-0">
                                        <a href="tel:+84987654321" class="text-decoration-none">0987 654 321</a><br>
                                        <a href="tel:+842836987456" class="text-decoration-none">028 3698 7456</a>
                                    </p>
                                </div>
                            </div>
                            
                            <div class="d-flex">
                                <div class="me-3 text-success">
                                    <i class="fas fa-envelope fa-2x"></i>
                                </div>
                                <div>
                                    <h5 class="fw-bold mb-1">Email</h5>
                                    <p class="mb-0">
