    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Styles", required: false)

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@section Scripts {
<script>
    $(document).ready(function () {
        // Function to update notification count
        function updateNotificationCount() {
            $.get("/Notification/GetUnreadCount", function (count) {
                const $badge = $("#notificationDropdown .badge");
                if (count > 0) {
                    $badge.text(count).show();
                } else {
                    $badge.hide();
                }
            });
        }

        // Update count immediately
        updateNotificationCount();

        // Set up periodic refresh (every 30 seconds)
        setInterval(updateNotificationCount, 30000);

        // When dropdown is shown, load notifications
        $('#notificationDropdown').on('click', function () {
            $.get("/Notification/GetRecentNotifications", function (notifications) {
                const $list = $(".notification-list");
                $list.empty();
                
                if (notifications && notifications.length > 0) {
                    notifications.forEach(function (item) {
                        $list.append(`
                            <a class="dropdown-item d-flex py-3 border-bottom ${!item.isRead ? "bg-light" : ""}" 
                               href="/Notification/Details/${item.id}">
                                <div class="me-3">
                                    <i class="${getNotificationIcon(item.type)} text-${getNotificationColor(item.type)}"></i>
                                </div>
                                <div class="flex-grow-1 overflow-hidden">
                                    <div class="d-flex justify-content-between">
                                        <h6 class="mb-1">${item.title}</h6>
                                        <small class="text-muted">${formatDate(item.createdAt)}</small>
                                    </div>
                                    <p class="mb-0 small text-truncate">${item.message}</p>
                                    ${!item.isRead ? '<span class="badge bg-primary float-end">Mới</span>' : ''}
                                </div>
                            </a>
                        `);
                    });
                } else {
                    $list.append(`
                        <div class="text-center py-4">
                            <i class="fas fa-bell-slash fa-2x text-muted mb-2"></i>
                            <p class="text-muted">Không có thông báo mới</p>
                        </div>
                    `);
                }
            });
        });

        function getNotificationColor(type) {
            switch(type) {
                case 'order': return 'success';
                case 'message': return 'info';
                case 'warning': return 'warning';
                case 'system': return 'secondary';
                default: return 'primary';
            }
        }

        function getNotificationIcon(type) {
            switch(type) {
                case 'order': return 'fas fa-shopping-bag';
                case 'message': return 'fas fa-comment';
                case 'warning': return 'fas fa-exclamation-circle';
                case 'system': return 'fas fa-cog';
                default: return 'fas fa-bell';
            }
        }

        function formatDate(dateString) {
            const date = new Date(dateString);
            return date.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }) + ' ' + 
                   date.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit' });
        }
    });
</script>
}