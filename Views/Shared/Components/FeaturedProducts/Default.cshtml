@model List<MyWebApp.Models.Product>

<section id="products" class="py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold mb-3">Sản phẩm nổi bật</h2>
            <p class="lead text-muted">Khám phá những sản phẩm chất lượng cao từ PHATLEE</p>
            <a asp-controller="Product" asp-action="Index" class="btn btn-outline-success mt-2">
                Xem tất cả sản phẩm <i class="fas fa-arrow-right ms-2"></i>
            </a>
        </div>
        
        @{
            // Lấy 4 sản phẩm đầu tiên để hiển thị
            var featuredProducts = Model?.Take(4).ToList() ?? new List<MyWebApp.Models.Product>();
        }
        
        @if (featuredProducts.Any())
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
                @foreach (var product in featuredProducts)
                {
                    <div class="col">
                        <div class="card h-100 border-0 shadow-sm product-card">
                            @if (!string.IsNullOrEmpty(product.Model3DUrl))
                            {
                                <span class="position-absolute top-0 end-0 m-2 badge bg-info">
                                    <i class="fas fa-cube me-1"></i>3D
                                </span>
                            }
                            
                            <div class="product-image-container">
                                <img src="@(product.ImageUrl ?? "/images/default-product.png")" class="card-img-top" alt="@product.Name">
                            </div>
                            
                            <div class="card-body">
                                <h5 class="card-title">@product.Name</h5>
                                <p class="text-muted small mb-2">@(product.Category?.Name ?? "Chưa phân loại")</p>
                                
                                <div class="d-flex align-items-center mb-2">
                                    <div class="rating-stars text-warning small">
                                        <i class="fas fa-star"></i>
                                        <i class="fas fa-star"></i>
                                        <i class="fas fa-star"></i>
                                        <i class="fas fa-star"></i>
                                        <i class="far fa-star"></i>
                                    </div>
                                    <span class="ms-2 small">(12 đánh giá)</span>
                                </div>
                                
                                <p class="card-text text-truncate-3 mb-3">@product.Description</p>
                                <h5 class="text-success mb-0">@product.Price.ToString("N0")đ</h5>
                            </div>
                            
                            <div class="card-footer bg-white border-0 pt-0">
                                <div class="d-flex justify-content-between">
                                    <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="btn btn-sm btn-success">
                                        <i class="fas fa-info-circle me-1"></i>Xem chi tiết
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-box-open fa-3x text-muted mb-3"></i>
                <h5 class="text-muted">Không có sản phẩm nào</h5>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Product" asp-action="Create" class="btn btn-success mt-3">
                        <i class="fas fa-plus me-2"></i>Thêm sản phẩm mới
                    </a>
                }
            </div>
        }
    </div>
</section>