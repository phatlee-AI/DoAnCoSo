@using System.Linq
@model IEnumerable<MyWebApp.Models.UserNotification> // ✅ linh hoạt hơn, chấp nhận cả List và Array

    

@{
    var unreadCount = ViewBag.UnreadCount ?? 0;
}

<div class="dropdown">
    <a class="nav-link position-relative" href="#" id="notificationDropdown" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="fas fa-bell"></i>
        @if (unreadCount > 0)
        {
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                @unreadCount
                <span class="visually-hidden">unread notifications</span>
            </span>
        }
    </a>

    <ul class="dropdown-menu dropdown-menu-end dropdown-menu-lg shadow" aria-labelledby="notificationDropdown" style="min-width: 350px;">
        <li>
            <div class="dropdown-header bg-light py-2 d-flex justify-content-between align-items-center">
                <h6 class="m-0">Thông báo (@unreadCount mới)</h6>
                @if (unreadCount > 0)
                {
                    <form asp-controller="Notification" asp-action="MarkAllAsRead" method="post">
                        <button type="submit" class="btn btn-sm btn-link text-primary p-0">Đánh dấu đã đọc tất cả</button>
                    </form>
                }
            </div>
        </li>
        <li>
            <div class="notification-list" style="max-height: 400px; overflow-y: auto;">
                @if (!Model.Any())
                {
                    <div class="text-center py-4">
                        <i class="fas fa-bell-slash fa-2x text-muted mb-2"></i>
                        <p class="text-muted">Không có thông báo mới</p>
                    </div>
                }
                else
                {
                    @foreach (var n in Model)
                    {
                        <a class="dropdown-item d-flex py-3 border-bottom @(!n.IsRead ? "bg-light" : "")" 
                           asp-controller="Notification" asp-action="Details" asp-route-id="@n.Id">
                            
                            <div class="flex-grow-1 overflow-hidden">
                                <div class="d-flex justify-content-between">
                                    
                                    <small class="text-muted">@n.CreatedAt.ToString("HH:mm dd/MM")</small>
                                </div>
                                <p class="mb-0 small text-truncate">@n.Message</p>
                                @if (!n.IsRead)
                                {
                                    <span class="badge bg-primary float-end">Mới</span>
                                }
                            </div>
                        </a>
                    }
                }
            </div>
        </li>
        <li class="dropdown-footer text-center py-2 border-top">
            <a asp-controller="Notification" asp-action="Index" class="text-primary small">
                <i class="fas fa-list me-1"></i>Xem tất cả thông báo
            </a>
        </li>
    </ul>
</div>

@functions {
    string GetNotificationColor(string type)
    {
        return type switch
        {
            "order" => "success",
            "message" => "info",
            "warning" => "warning",
            "system" => "secondary",
            _ => "primary"
        };
    }

    string GetNotificationIcon(string type)
    {
        return type switch
        {
            "order" => "fas fa-shopping-bag",
            "message" => "fas fa-comment",
            "warning" => "fas fa-exclamation-circle",
            "system" => "fas fa-cog",
            _ => "fas fa-bell"
        };
    }
}