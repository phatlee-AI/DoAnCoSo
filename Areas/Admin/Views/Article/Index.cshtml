@model IEnumerable<MyWebApp.Models.Article>
@using X.PagedList
@using X.PagedList.Mvc.Core
@{
    ViewData["Title"] = "Article Management";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    
    var pagedList = Model as IPagedList<Article>;
    var searchQuery = Context.Request.Query["search"];
    var statusFilter = Context.Request.Query["status"];
}

<div class="card shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">
            <i class="fas fa-newspaper me-2 text-primary"></i>@ViewData["Title"]
        </h5>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="fas fa-plus me-1"></i>Create New
        </a>
    </div>
    
    <!-- Search and Filter Section -->
    <div class="card-body border-bottom">
        <form method="get" class="row g-3">
            <div class="col-md-6">
                <div class="input-group">
                    <input type="text" name="search" class="form-control" placeholder="Search articles..." value="@searchQuery">
                    <button type="submit" class="btn btn-outline-primary">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select" onchange="this.form.submit()">
                    <option value="">All Statuses</option>
                    <option value="published" selected="@(statusFilter == "published")">Published</option>
                    <option value="draft" selected="@(statusFilter == "draft")">Drafts</option>
                </select>
            </div>
            <div class="col-md-3 text-end">
                <a asp-action="Index" class="btn btn-outline-secondary">Reset Filters</a>
            </div>
        </form>
    </div>

    <!-- Articles Table -->
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>
                            <a asp-action="Index" 
                               asp-route-sortOrder="@ViewData["TitleSort"]"
                               asp-route-search="@searchQuery"
                               asp-route-status="@statusFilter">
                                Title
                                @if (ViewData["CurrentSort"]?.ToString() == "title_desc")
                                {
                                    <i class="fas fa-sort-down ms-1"></i>
                                }
                                else if (ViewData["CurrentSort"]?.ToString() == "title_asc")
                                {
                                    <i class="fas fa-sort-up ms-1"></i>
                                }
                                else
                                {
                                    <i class="fas fa-sort ms-1"></i>
                                }
                            </a>
                        </th>
                        <th>Author</th>
                        <th>
                            <a asp-action="Index" 
                               asp-route-sortOrder="@ViewData["DateSort"]"
                               asp-route-search="@searchQuery"
                               asp-route-status="@statusFilter">
                                Created
                                @if (ViewData["CurrentSort"]?.ToString() == "date_desc")
                                {
                                    <i class="fas fa-sort-down ms-1"></i>
                                }
                                else if (ViewData["CurrentSort"]?.ToString() == "date_asc")
                                {
                                    <i class="fas fa-sort-up ms-1"></i>
                                }
                                else
                                {
                                    <i class="fas fa-sort ms-1"></i>
                                }
                            </a>
                        </th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var article in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        @if (!string.IsNullOrEmpty(article.ImageUrl))
                                        {
                                            <img src="@article.ImageUrl" alt="@article.Title" class="rounded me-3" width="60" height="40" style="object-fit: cover;">
                                        }
                                        <div>
                                            <h6 class="mb-0">@article.Title</h6>
                                            <small class="text-muted">@article.Slug</small>
                                        </div>
                                    </div>
                                </td>
                                <td>@article.Author?.UserName</td>
                                <td>@article.CreatedDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    @if (article.IsPublished)
                                    {
                                        <span class="badge bg-success">Published</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Draft</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-flex gap-2 justify-content-end">
                                        <a asp-action="Edit" asp-route-id="@article.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <form asp-action="TogglePublish" asp-route-id="@article.Id" method="post">
                                            <button type="submit" class="btn btn-sm @(article.IsPublished ? "btn-outline-warning" : "btn-outline-success")" title="@(article.IsPublished ? "Unpublish" : "Publish")">
                                                <i class="fas @(article.IsPublished ? "fa-eye-slash" : "fa-eye")"></i>
                                            </button>
                                        </form>
                                        <a asp-action="Details" asp-route-id="@article.Id" class="btn btn-sm btn-outline-info" title="Details">
                                            <i class="fas fa-info-circle"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@article.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this article?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4">
                                <div class="d-flex flex-column align-items-center">
                                    <i class="fas fa-newspaper fa-3x text-muted mb-3"></i>
                                    <h5 class="text-muted">No articles found</h5>
                                    <p class="text-muted">Create your first article by clicking the button above</p>
                                    <a asp-action="Create" class="btn btn-primary mt-2">
                                        <i class="fas fa-plus me-1"></i>Create Article
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (pagedList?.PageCount > 1)
    {
        <div class="card-footer bg-white">
            @Html.PagedListPager(pagedList, page => Url.Action("Index", new { 
                page,
                search = searchQuery,
                status = statusFilter,
                sortOrder = ViewData["CurrentSort"]
            }),
            new PagedListRenderOptions {
                LiElementClasses = new[] { "page-item" },
                PageClasses = new[] { "page-link" },
                DisplayLinkToFirstPage = PagedListDisplayMode.IfNeeded,
                DisplayLinkToLastPage = PagedListDisplayMode.IfNeeded,
                DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
                DisplayLinkToNextPage = PagedListDisplayMode.Always,
                MaximumPageNumbersToDisplay = 5
            })
        </div>
    }
</div>

@section Styles {
    <style>
        .table th a {
            text-decoration: none;
            color: inherit;
            display: flex;
            align-items: center;
        }
        .table th i {
            font-size: 0.8rem;
        }
        .badge {
            font-weight: 500;
            min-width: 80px;
        }
        .pagination {
            margin-bottom: 0;
        }
        .img-thumbnail {
            max-width: 100px;
            max-height: 60px;
            object-fit: cover;
        }
    </style>
}