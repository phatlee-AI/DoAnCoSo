@model MyWebApp.Models.ReportFeedback
@{
    ViewData["Title"] = "Trả lời phản hồi";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
            <i class="fas fa-reply me-2 text-primary"></i>Trả lời phản hồi từ @Model.Name
        </h2>
        <a asp-action="ReportList" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Quay lại
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <form asp-action="Reply" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                
                <div class="mb-4">
                    <h5 class="fw-semibold mb-3">Nội dung phản hồi gốc:</h5>
                    <div class="bg-light p-3 rounded">
                        <p class="mb-2"><strong>Người gửi:</strong> @Model.Name (@Model.Email)</p>
                        <p class="mb-2"><strong>Thời gian:</strong> @Model.SentAt.ToString("dd/MM/yyyy HH:mm")</p>
                        <hr>
                        <p>@Model.Message</p>
                    </div>
                </div>
                
                <div class="mb-4">
                    <label class="form-label fw-semibold">Phản hồi của bạn:</label>
                    <textarea name="AdminReply" class="form-control" rows="6" placeholder="Nhập nội dung phản hồi...">@Model.AdminReply</textarea>
                </div>
                
                <div class="text-end">
                    <button type="submit" class="btn btn-success px-4">
                        <i class="fas fa-paper-plane me-2"></i>Gửi phản hồi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>