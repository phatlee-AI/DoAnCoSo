@model MyWebApp.Areas.Admin.Models.ViewModels.ChiTietDonHangVM
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Chi tiết đơn hàng";
}

<div class="order-detail-container">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">
            <i class="fas fa-file-invoice me-2 text-primary"></i>Chi tiết đơn hàng #@Model.Id
        </h2>
        <div>
            <a href="@Url.Action("Index", "DonHang")" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Quay lại
            </a>
        </div>
    </div>

    <!-- Order Summary Card -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white border-0 py-3">
            <h5 class="fw-bold mb-0">
                <i class="fas fa-info-circle me-2 text-info"></i>Thông tin đơn hàng
            </h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    <div class="info-item mb-3">
                        <span class="fw-bold text-muted">Ngày đặt:</span>
                        <span>@Model.NgayLap.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                    <div class="info-item mb-3">
                        <span class="fw-bold text-muted">Tổng tiền:</span>
                        <span class="text-danger fw-bold">@Model.TongTien.ToString("N0") VND</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="info-item mb-3">
                        <span class="fw-bold text-muted">Khách hàng:</span>
                        <span>@Model.TenNguoiNhan</span>
                    </div>
                    @* <div class="info-item mb-3">
                        <span class="fw-bold text-muted">SĐT:</span>
                        <span>@Model.SoDienThoai</span>
                    </div> *@
                </div>
                <div class="col-md-4">
                    <div class="info-item mb-3">
                        <span class="fw-bold text-muted">Địa chỉ:</span>
                        <span>@Model.DiaChi</span>
                    </div>
                    <div class="info-item">
                        <span class="fw-bold text-muted">Trạng thái:</span>
                        <span class="badge @GetStatusBadgeClass(Model.Status)">@Model.Status</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Order Items Card -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white border-0 py-3">
            <h5 class="fw-bold mb-0">
                <i class="fas fa-box-open me-2 text-success"></i>Sản phẩm đã đặt (@Model.DanhSachSanPham.Count)
            </h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Sản phẩm</th>
                            <th class="text-center">Số lượng</th>
                            <th class="text-end">Đơn giá</th>
                            <th class="text-end pe-4">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sp in Model.DanhSachSanPham)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="flex-shrink-0">
                                            <img src="@sp.HinhAnh" width="60" height="60" />

                                        </div>
                                        <div class="flex-grow-1 ms-3">
                                            <h6 class="mb-1">@sp.TenSanPham</h6>
                                            @* <small class="text-muted">SKU: @sp.MaSanPham</small> *@
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center align-middle">@sp.SoLuong</td>
                                <td class="text-end align-middle">@sp.DonGia.ToString("N0") VND</td>
                                <td class="text-end pe-4 align-middle fw-bold">@((sp.SoLuong * sp.DonGia).ToString("N0")) VND</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="3" class="text-end fw-bold">Tạm tính:</td>
                            <td class="text-end pe-4 fw-bold">@Model.TongTien.ToString("N0") VND</td>
                        </tr>
                        @* <tr>
                            <td colspan="3" class="text-end fw-bold">Phí vận chuyển:</td>
                            <td class="text-end pe-4 fw-bold">@Model.PhiVanChuyen.ToString("N0") VND</td>
                        </tr> *@
                        <tr>
                            <td colspan="3" class="text-end fw-bold fs-5">Tổng cộng:</td>
                            <td class="text-end pe-4 fw-bold fs-5 text-danger">@Model.TongTien.ToString("N0") VND</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="d-flex justify-content-end mt-4 gap-3">
        @if (Model.Status == "Pending")
        {
            <button class="btn btn-success px-4">
                <i class="fas fa-check me-2"></i>Xác nhận đơn
            </button>
        }
        <button class="btn btn-outline-primary px-4">
            <i class="fas fa-print me-2"></i>In hóa đơn
        </button>
        <button class="btn btn-outline-danger px-4">
            <i class="fas fa-times me-2"></i>Hủy đơn
        </button>
    </div>
</div>

@functions {
    string GetStatusBadgeClass(string status)
    {
        switch (status.ToLower())
        {
            case "completed":
                return "bg-success";
            case "pending":
                return "bg-warning text-dark";
            case "processing":
                return "bg-info";
            case "cancelled":
                return "bg-danger";
            case "shipped":
                return "bg-primary";
            default:
                return "bg-secondary";
        }
    }
}

@section Styles {
    <style>
        .order-detail-container {
            padding: 1.5rem;
            background-color: #f8fafc;
        }

        .info-item {
            padding: 0.5rem 0;
            display: flex;
            justify-content: space-between;
            border-bottom: 1px solid #f1f1f1;
        }

        .info-item:last-child {
            border-bottom: none;
        }

        .info-item span:first-child {
            min-width: 120px;
        }

        .table th {
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.5px;
            color: #64748b;
        }

        .card {
            border-radius: 12px;
            border: none;
        }

        .card-header {
            border-radius: 12px 12px 0 0 !important;
        }

        .badge {
            font-size: 0.85em;
            padding: 0.35em 0.65em;
            font-weight: 500;
        }
    </style>
}