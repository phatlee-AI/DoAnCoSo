@model MyWebApp.Models.Product

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Product</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-controller="Product" asp-area="Admin" asp-action="Edit" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="All" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Price" class="control-label"></label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="col-6">
                    <div class="form-group">
                        <p>Ảnh hiện tại</p>
                        <img src="@Model.ImageUrl" width="100" />
                    </div>
                </div>
                <div class="col-6">
                    <div class=" mb-3">
                        <label asp-for="ImageUrl">Chọn Hình Ảnh </label>
                        <input name="HinhAnhCapNhat" id="AnhVuaTai" type="file" placeholder="Nhập Hình Ảnh" class="form-control" />
                        <div class="ChuaAnh my-3"></div>
                    </div>
                </div>
            </div>

            
            <div class=" mb-3">
                <label asp-for="ImageUrl">Chọn ds Hình Ảnh mới </label>
                <input name="DanhSachHinhAnh" multiple id="AnhVuaTaiDS" type="file" placeholder="Nhập Hình Ảnh" class="form-control" />
                <div class="ChuaAnhDS my-3"></div>
            </div>
            <div class="form-group">
                <label asp-for="CategoryId" class="control-label"></label>
                <select asp-for="CategoryId" class="form-control" asp-items="ViewBag.CategoryId"></select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        $("#AnhVuaTai").change(function(e){//input #AnhVuaTai
            let a = e.target.files[0]; // lấy thằng file đầu tiên
            if(a != null)
            {
                let path = URL.createObjectURL(a) // lấy ra địa chỉ
                let s = `<img src="${path}" style="width:100px"/>`;
                $(".ChuaAnh").append(s);
            }
        });

                 $("#AnhVuaTaiDS").change(function(e) { // input #AnhVuaTai
            let files = e.target.files; // lấy tất cả các file
            if (files.length > 0) {
                // Xóa nội dung trước đó (nếu cần)
                $(".ChuaAnhDS").empty();

                for (let i = 0; i < files.length; i++) { // sử dụng length thay vì count()
                    let path = URL.createObjectURL(files[i]); // lấy ra địa chỉ
                    let s = `<img src="${path}" style="width:100px"/>`;
                    $(".ChuaAnhDS").append(s);
                }
            }
        });

    </script>

}
