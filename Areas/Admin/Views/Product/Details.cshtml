@model MyWebApp.Models.Product

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Product</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Price)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Price)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ImageUrl)
        </dt>
        <dd class = "col-sm-10">
            <p>Ảnh Đại Diện</p>
            <img src="@Model.ImageUrl"  width="100"/>
        </dd>
        <dt class = "col-sm-2">
            <p>Danh Sách Ảnh</p>
           @{
                if (ViewBag.dshinhanh != null)
                {
                    foreach (MyWebApp.Models.ProductImage i in ViewBag.dshinhanh)
                    {
                        <img src="@i.Url" width="100" />
                    }
                }
           }
        </dt>
        <dd class = "col-sm-10">
            <p>@Model.Category.Name</p>

        </dd>
    </dl>
</div>
<div>
    <a asp-controller="Product" asp-area="Admin" asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-controller="Product" asp-area="Admin" asp-action="Index">Back to List</a>
</div>
