@model IEnumerable<IdentityUser>
@using Microsoft.AspNetCore.Identity
@{
    ViewData["Title"] = "User Management";
}

<h1 class="text-center">User Management</h1>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Email</th>
            <th>Role</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            var role = ViewBag.UserRoles[user.Id];
            <tr>
                <td>@user.Email</td>
                <td>@role</td>
                <td>
                    @if (role != "Admin" || user.Id == User.FindFirst("sub")?.Value)
                    {
                        @if (role != "Admin")
                        {
                            <a asp-action="Promote" asp-route-id="@user.Id" class="btn btn-success btn-sm">Promote</a>
                        }
                        @if (role != "Customer")
                        {
                            <a asp-action="Demote" asp-route-id="@user.Id" class="btn btn-warning btn-sm">Demote</a>
                        }
                        <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-danger btn-sm">Delete</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>